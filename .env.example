# Copia este archivo a .env y rellena tus valores (Anexo A, campo a campo).

# Ruta local donde Ollama expone su API (normalmente no hay que cambiarla)
OLLAMA_HOST=http://localhost:11434

# Modelo por defecto que usan los agentes si no se indica otro (capitulo 2)
OLLAMA_MODEL=llama3.1:8b

# Credenciales de correo para el agente de correo (capitulo 6, protocolo IMAP)
# Nota: usa una contrasena de aplicacion, no la de tu cuenta (Anexo B)
IMAP_SERVER=imap.gmail.com
IMAP_USER=tu_correo@gmail.com
IMAP_PASSWORD=tu_contrasena_de_aplicacion

# Ruta donde el agente de organizacion de archivos busca y ordena documentos
FILES_ROOT=/home/usuario/Documentos

# --- Opcionales: cada agente indica en su README si los necesita ---

# Carpeta con tus notas .md/.txt para el segundo cerebro (capitulo 4)
NOTES_DIR=data/notes

# Modelo de embeddings para el indice del segundo cerebro
OLLAMA_EMBED_MODEL=nomic-embed-text

# Modelo de vision para el lector de facturas (capitulo 8)
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Modelo del orquestador (capitulo 13; necesita tool calling nativo)
ORCHESTRATOR_MODEL=qwen2.5:14b-instruct

# Tamano del modelo Whisper para transcripcion (tiny/base/small/medium)
WHISPER_MODEL=base

# Voz de Piper para el asistente de voz (capitulo 12; vacio = solo texto)
PIPER_VOICE=
